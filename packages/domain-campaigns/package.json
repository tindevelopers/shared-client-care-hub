{
  "name": "@tindevelopers/domain-campaigns",
  "version": "1.1.0-rc.0",
  "license": "MIT",
  "description": "Campaigns domain package — tenant-scoped campaign store (CRUD + stats + recipients), calling-window scheduling, and the provider-agnostic marketing campaign service with injected dependencies",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "@tindevelopers/adapter-kit": "1.3.0",
    "@tindevelopers/schema-crm": "^1.1.0-rc.0"
  },
  "peerDependencies": {
    "@tindevelopers/core-kernel": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
