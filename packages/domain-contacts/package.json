{
  "name": "@tindevelopers/domain-contacts",
  "version": "1.2.0-rc.1",
  "license": "MIT",
  "description": "Contacts domain package — owns the canonical contacts aggregate: tenant-tier store, system-tier store, suppression + crm-sync subscribers, segment materializer",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./suppression": {
      "types": "./dist/suppression/suppression-subscriber.d.ts",
      "import": "./dist/suppression/suppression-subscriber.js",
      "default": "./dist/suppression/suppression-subscriber.js"
    },
    "./crm-sync": {
      "types": "./dist/crm-sync/subscriptions.d.ts",
      "import": "./dist/crm-sync/subscriptions.js",
      "default": "./dist/crm-sync/subscriptions.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "@tindevelopers/adapter-kit": "1.5.0",
    "@tindevelopers/schema-crm": "workspace:^",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "@tindevelopers/core-kernel": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
