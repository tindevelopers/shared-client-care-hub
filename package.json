{
  "name": "shell-base-crm",
  "version": "0.0.0",
  "private": true,
  "description": "CRM domain hub: schema-crm, domain-contacts, and domain-campaigns packages",
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "changeset": "changeset",
    "lint": "eslint . --max-warnings=0",
    "type-check": "pnpm -r type-check",
    "depcruise": "node scripts/depcruise.mjs",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs packages",
    "test": "depcruise --config .dependency-cruiser.cjs packages && vitest run --passWithNoTests",
    "build": "pnpm -r build",
    "validate:packages": "node scripts/validate-packages.mjs",
    "quality": "pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm validate:packages",
    "audit": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@tindevelopers/core-kernel": "1.0.0",
    "@tindevelopers/schema-crm": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.2",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "^3.2.7"
  }
}
